  "pubmed_bulk_loader": {
    "output_path": "C:/Users/sonja/OneDrive - Lund University/data_vault/external_data/pubmed/25/json2/",
    "baseline": "25",
    "subset": true,
    "subset_range":[0,0],
    "get_nightly_update_files": true,
    "update_file_range":[1283,1309],
    "count_articles": true,
    "raw_download_path": "C:/Users/sonja/OneDrive - Lund University/data_vault/external_data/pubmed/25/raw2/"
  },
  "splitter": {
    "input_path": "results/medmentions_original_preprocessed.json",
